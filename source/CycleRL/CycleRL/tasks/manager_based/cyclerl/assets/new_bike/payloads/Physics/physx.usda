#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "new_bike"
    doc = """Generated from Composed Stage of root layer /tmp/tmppvrqbpqv/new_bike.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_new_bike_o72k7luu/usdex_new_bike/new_bike.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_new_bike_o72k7luu/temp_new_bike/new_bike.usd


Generated from Composed Stage of root layer /home/lmbike2/bike_models/thubike_new/new_bike/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "new_bike"
{
    over "Geometry"
    {
        over "base_link"
        {
            over "rearwheel"
            {
                over "rearwheel_joint" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                }
            }

            over "steer"
            {
                over "frontwheel"
                {
                    over "frontwheel_joint" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                    }
                }

                over "steering_joint" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.001
                }
            }
        }
    }
}

