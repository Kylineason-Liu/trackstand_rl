#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "new_bike"
    doc = """Generated from Composed Stage of root layer /tmp/tmppvrqbpqv/new_bike.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_new_bike_o72k7luu/usdex_new_bike/new_bike.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_new_bike_o72k7luu/temp_new_bike/new_bike.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "new_bike" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </new_bike/Geometry/base_link/payload_power_distribution_board/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_raspberry_pi/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_transformer/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_servo_power/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_raspberry_pi_power/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_connection_accessory/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_battery/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_imu_fixing_plate_left/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_imu_fixing_plate_right/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/payload_imu_wood_plate/PhysicsFixedJoint>,
        </new_bike/Geometry/base_link/rearwheel/rearwheel_joint>,
        </new_bike/Geometry/base_link/steer/steering_joint>,
        </new_bike/Geometry/base_link/steer/frontwheel/frontwheel_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </new_bike/Geometry/base_link>,
        </new_bike/Geometry/base_link/payload_power_distribution_board>,
        </new_bike/Geometry/base_link/payload_raspberry_pi>,
        </new_bike/Geometry/base_link/payload_transformer>,
        </new_bike/Geometry/base_link/payload_servo_power>,
        </new_bike/Geometry/base_link/payload_raspberry_pi_power>,
        </new_bike/Geometry/base_link/payload_connection_accessory>,
        </new_bike/Geometry/base_link/payload_battery>,
        </new_bike/Geometry/base_link/payload_imu_fixing_plate_left>,
        </new_bike/Geometry/base_link/payload_imu_fixing_plate_right>,
        </new_bike/Geometry/base_link/payload_imu_wood_plate>,
        </new_bike/Geometry/base_link/rearwheel>,
        </new_bike/Geometry/base_link/steer>,
        </new_bike/Geometry/base_link/steer/frontwheel>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "payload_power_distribution_board" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_raspberry_pi" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_transformer" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_servo_power" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_raspberry_pi_power" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_connection_accessory" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_battery" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_imu_fixing_plate_left" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_imu_fixing_plate_right" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "payload_imu_wood_plate" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "PhysicsFixedJoint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "rearwheel" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rearwheel_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }

            over "steer" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "frontwheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "frontwheel_joint" (
                        prepend apiSchemas = ["IsaacJointAPI"]
                    )
                    {
                    }
                }

                over "steering_joint" (
                    prepend apiSchemas = ["IsaacJointAPI"]
                )
                {
                }
            }
        }
    }
}

