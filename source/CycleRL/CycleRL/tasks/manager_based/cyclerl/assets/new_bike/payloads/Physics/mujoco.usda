#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "new_bike"
    doc = """Generated from Composed Stage of root layer /tmp/tmppvrqbpqv/new_bike.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_new_bike_o72k7luu/usdex_new_bike/new_bike.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_new_bike_o72k7luu/temp_new_bike/new_bike.usd


Generated from Composed Stage of root layer /home/lmbike2/bike_models/thubike_new/new_bike/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "new_bike"
{
    over "Geometry"
    {
        over "floor" (
            prepend apiSchemas = ["MjcCollisionAPI"]
        )
        {
            uniform int mjc:group = 2
        }

        over "base_link"
        {
            over "imu_site" (
                prepend apiSchemas = ["MjcSiteAPI"]
            )
            {
            }

            over "rearwheel"
            {
                over "rearwheel_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:damping = 0.001
                }

                over "rear_wheel_link_geom"
                {
                }
            }

            over "steer"
            {
                over "frontwheel"
                {
                    over "frontwheel_joint" (
                        delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                        prepend apiSchemas = ["MjcJointAPI"]
                    )
                    {
                        uniform double mjc:damping = 0.001
                    }

                    over "front_wheel_link_geom"
                    {
                    }
                }

                over "steering_joint" (
                    delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
                    prepend apiSchemas = ["MjcJointAPI"]
                )
                {
                    uniform double mjc:armature = 0.001
                    uniform double mjc:damping = 0.05
                }

                over "steering_link_geom"
                {
                }
            }

            over "payload_power_distribution_board"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_pdb_geom"
                {
                }
            }

            over "payload_raspberry_pi"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_rpi_geom"
                {
                }
            }

            over "payload_transformer"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_transformer_geom"
                {
                }
            }

            over "payload_servo_power"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_servo_power_geom"
                {
                }
            }

            over "payload_raspberry_pi_power"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_rpi_power_geom"
                {
                }
            }

            over "payload_connection_accessory"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_connection_accessory_geom"
                {
                }
            }

            over "payload_battery"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_battery_geom"
                {
                }
            }

            over "payload_imu_fixing_plate_left"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_imu_fixing_left_geom"
                {
                }
            }

            over "payload_imu_fixing_plate_right"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_imu_fixing_right_geom"
                {
                }
            }

            over "payload_imu_wood_plate"
            {
                over "PhysicsFixedJoint"
                {
                }

                over "step_imu_wood_plate_geom"
                {
                }
            }

            over "base_link_geom"
            {
            }

            over "step_imu_geom"
            {
            }
        }
    }

    over "Physics"
    {
        over "PhysicsMaterial" (
            prepend apiSchemas = ["MjcMaterialAPI"]
        )
        {
        }

        def MjcActuator "cmd_steering_f"
        {
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 5.6
            uniform double mjc:ctrlRange:min = -5.6
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 5.6
            uniform double mjc:forceRange:min = -5.6
            uniform int mjc:group = 2
            custom rel mjc:target
            prepend rel mjc:target = </new_bike/Geometry/base_link/steer/steering_joint>
        }

        def MjcActuator "cmd_rearwheel_f"
        {
            uniform token mjc:ctrlLimited = "true"
            uniform double mjc:ctrlRange:max = 6.28
            uniform double mjc:ctrlRange:min = -6.28
            uniform token mjc:forceLimited = "true"
            uniform double mjc:forceRange:max = 6.28
            uniform double mjc:forceRange:min = -6.28
            uniform int mjc:group = 2
            custom rel mjc:target
            prepend rel mjc:target = </new_bike/Geometry/base_link/rearwheel/rearwheel_joint>
        }
    }

    over "Materials"
    {
        over "groundplane"
        {
        }
    }
}

over "PhysicsScene" (
    prepend apiSchemas = ["MjcSceneAPI"]
)
{
    uniform token mjc:compiler:angle = "radian"
    uniform token mjc:compiler:inertiaFromGeom = "false"
    uniform bool mjc:flag:multiccd = 0
    uniform token mjc:option:cone = "elliptic"
    uniform token mjc:option:integrator = "rk4"
    uniform int mjc:option:iterations = 50
    uniform double mjc:option:timestep = 0.0005
    uniform double mjc:option:tolerance = 1e-10
}

