#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "thubike2"
    doc = """Generated from Composed Stage of root layer /tmp/tmp3cilcbar/thubike2.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_thubike2_qfpo6xbn/usdex_thubike2/thubike2.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_thubike2_qfpo6xbn/temp_thubike2/thubike2.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "thubike2" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </thubike2/Physics/Revolute_8>,
        </thubike2/Physics/Revolute_9>,
        </thubike2/Physics/Rigid_10>,
        </thubike2/Physics/Revolute_7>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </thubike2/Geometry/base_link>,
        </thubike2/Geometry/base_link/rear_wheel_link_1>,
        </thubike2/Geometry/base_link/steering_link_1>,
        </thubike2/Geometry/base_link/steering_link_1/front_wheel_link_1>,
        </thubike2/Geometry/base_link/weights_1>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "rear_wheel_link_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "steering_link_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_wheel_link_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "weights_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "Revolute_7" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Revolute_8" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Revolute_9" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Rigid_10" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

