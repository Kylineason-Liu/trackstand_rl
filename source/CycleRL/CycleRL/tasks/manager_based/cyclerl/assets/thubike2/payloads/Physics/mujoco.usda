over "thubike2"
{
    over "Physics"
    {
        def MjcActuator "Revolute_7_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </thubike2/Physics/Revolute_7>
        }

        def MjcActuator "Revolute_8_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </thubike2/Physics/Revolute_8>
        }

        def MjcActuator "Revolute_9_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </thubike2/Physics/Revolute_9>
        }

        over "Revolute_7" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
