#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "xuan_bike2"
    doc = """Generated from Composed Stage of root layer /tmp/tmpaedmg0mh/xuan_bike2.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_xuan_bike2_b8bmxhz0/usdex_xuan_bike2/xuan_bike2.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_xuan_bike2_b8bmxhz0/temp_xuan_bike2/xuan_bike2.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "xuan_bike2" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </xuan_bike2/Physics/Revolute_7>,
        </xuan_bike2/Physics/Revolute_9>,
        </xuan_bike2/Physics/Revolute_11>,
        </xuan_bike2/Physics/Revolute_8>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </xuan_bike2/Geometry/base_link>,
        </xuan_bike2/Geometry/base_link/steering_1>,
        </xuan_bike2/Geometry/base_link/steering_1/wheel_front_1>,
        </xuan_bike2/Geometry/base_link/wheel_rear_1>,
        </xuan_bike2/Geometry/base_link/flywheel_1>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "steering_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wheel_front_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "wheel_rear_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "flywheel_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "Revolute_7" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Revolute_8" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Revolute_9" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "Revolute_11" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

