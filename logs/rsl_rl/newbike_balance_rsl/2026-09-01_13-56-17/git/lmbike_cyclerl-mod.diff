+def balance_yaw_band(
+    env: ManagerBasedRLEnv,
+    sigma: float = 0.4,  # rad (~23 deg): free reorientation allowance
+    asset_cfg: SceneEntityCfg = SceneEntityCfg("robot"),
+) -> torch.Tensor:
+    """Gaussian band on |yaw| relative to the spawn heading (yaw=0 at reset).
+
+    ANTI-ORBITAL term. A track stand oscillates around a fixed heading, but a
+    policy holding a constant steer deflection + roll rides a CIRCLE around the
+    spawn: radial drift metrics (and drift_band) are blind to orbital motion,
+    so a circle inside the drift band earns full position credit forever and
+    only the horizon ends the episode. Yaw accumulates on a circle, so this
+    band prices orbiting out while small reorientations stay (nearly) free.
+    """
+    asset = env.scene[asset_cfg.name]
+    q = asset.data.root_quat_w  # (w, x, y, z)
+    yaw = torch.atan2(
+        2.0 * (q[:, 0] * q[:, 3] + q[:, 1] * q[:, 2]),
+        1.0 - 2.0 * (q[:, 2] ** 2 + q[:, 3] ** 2),
+    )
+    return torch.exp(-(yaw**2) / (2.0 * sigma**2))
+
+
